{
  "expo": {
    "name": "FitCoach",
    "slug": "fitcoach",
    "scheme": "fitcoach",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "mx.fitcoach.app" },
    "android": { "package": "mx.fitcoach.app", "adaptiveIcon": { "backgroundColor": "#17191c" } },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": true }
  }
}
