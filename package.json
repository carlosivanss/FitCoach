{
  "name": "fitcoach",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:web": "vite --host 0.0.0.0",
    "dev:mobile": "pnpm --dir mobile start",
    "android": "pnpm --dir mobile android",
    "ios": "pnpm --dir mobile ios",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --configLoader runner",
    "typecheck": "pnpm --dir packages/shared typecheck && pnpm --dir mobile typecheck"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
